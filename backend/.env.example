# AvaScho Lead Intelligence — backend environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Loaded automatically by the app when running from backend/.

# ---------------------------------------------------------------- app ----
APP_ENV=development          # development | test | production
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# ---------------------------------------------------- database / queue ----
# Default: local Postgres via docker-compose
DATABASE_URL=postgresql+psycopg2://avascho:avascho@localhost:5432/avascho
REDIS_URL=redis://localhost:6379/0
EXECUTION_MODE=inline        # inline | celery

# ------------------------------------------------- Google Places (new API) -
# Google Maps is accessed ONLY through the official Places API `searchText`
# (https://maps.googleapis.com/maps/api/place/textsearch/json or the new
# Places API) — never scraping. Leave SEARCH_PROVIDER=auto and set the key:
GOOGLE_MAPS_API_KEY=
SEARCH_PROVIDER=auto          # auto | google | mock
MAX_RESULTS_PER_SEARCH=100

# -------------------------------------------------------------- AI ----
# rule_based = offline deterministic audit + proposals (no external calls).
# openai_compatible = evidence-based analysis by LLM.
AI_PROVIDER=rule_based
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ----------------------------------------------------- auth / security ----
# SECRET_KEY: long random value, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ENCRYPTION_KEY: Fernet key used to encrypt OAuth tokens at rest.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------- demo seed ----
AUTO_CREATE_DEMO_USER=true
DEMO_EMAIL=demo@avascho.com
DEMO_PASSWORD=change-me-too
DEMO_WORKSPACE=AvaScho

# ------------------------------------------------------- Gmail OAuth ----
# Needed to connect real Gmail sending accounts. Without it the app runs in
# demo mode (mock sender, nothing leaves the machine).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/email-accounts/gmail/callback

# ------------------------------------------------- email limits / policy ----
# Demo / mock sending is ON by default so the full funnel works offline.
# In production set ALLOW_MOCK_EMAIL_SENDING=false.
ALLOW_MOCK_EMAIL_SENDING=true
DAILY_EMAIL_LIMIT=5
MIN_SEND_DELAY_SECONDS=90
MAX_SEND_DELAY_SECONDS=420
ALLOWED_HOURS_START=9
ALLOWED_HOURS_END=19
WORKING_DAYS=1,2,3,4,5        # ISO weekday numbers, comma separated

# ------------------------------------------------- Google Sheets export ----
# Appends leads to a spreadsheet with a Google service account (replaces the old
# n8n `googleSheets append` + serviceAccount workflow).
#
# 1. Google Cloud Console → IAM & Admin → Service Accounts → Create service
#    account (no extra roles needed).
# 2. Keys → Add key → Create new key → JSON. Download the file.
# 3. Enable the "Google Sheets API" for the project
#    (APIs & Services → Library → Google Sheets API → Enable).
# 4. Copy the whole JSON key into ONE line below (escape the inner quotes/newlines
#    or use `python3 -c "import json,sys;print(json.dumps(open(sys.argv[1]).read()))" key.json`).
#    The app reads the JSON from this string — it never opens a key file.
# 5. Open your spreadsheet → Share → add the `client_email` of the service account
#    with the **Editor** role (otherwise the API answers 403).
#
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON expects the FULL JSON key as a single line:
# {"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"avascho@project.iam.gserviceaccount.com",...}
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# The long id from https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_DEFAULT_SPREADSHEET_ID=
GOOGLE_SHEETS_DEFAULT_SHEET_NAME=Leads

DEFAULT_MAX_RESULTS=100
