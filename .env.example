# =====================================================================
# AvaScho Lead Intelligence — Environment configuration
# Copy to .env and fill in real values. Never commit .env.
# =====================================================================

# ---- Google Places API (New). Backend only. Never expose to the frontend.
GOOGLE_MAPS_API_KEY=
# auto: use the real API when a key is set, otherwise offline mock (demo/tests)
SEARCH_PROVIDER=auto

# ---- PostgreSQL ------------------------------------------------------
# Local dev:  postgresql+psycopg2://avascho:avascho@localhost:5432/avascho
# Docker:     postgresql+psycopg2://avascho:avascho@postgres:5432/avascho
DATABASE_URL=postgresql+psycopg2://avascho:avascho@localhost:5432/avascho

# ---- Redis / queue ----------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# inline  -> pipeline runs inside the API process (single-machine dev / tests)
# celery  -> pipeline is dispatched to the Celery worker via Redis
EXECUTION_MODE=inline

# ---- AI Provider --------------------------------------------------------
# openai_compatible | rule_based (offline, evidence-based, deterministic) | mock
AI_PROVIDER=rule_based
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---- Gmail OAuth 2.0 (only needed for real sending) ----------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/email-accounts/gmail/callback

# ---- Security -------------------------------------------------------------
# Secret used for JWT signing (openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key used to encrypt OAuth tokens at rest (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=
# Comma separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Demo / seed user (dev convenience; set AUTO_CREATE_DEMO_USER=false in prod)
AUTO_CREATE_DEMO_USER=true
DEMO_EMAIL=demo@avascho.com
DEMO_PASSWORD=demo-avascho-2026
DEMO_WORKSPACE=AvaScho

# ---- Search & crawling limits ----------------------------------------------
MAX_RESULTS_PER_SEARCH=100
MAX_PAGES_PER_DOMAIN=10
MAX_PAGE_SIZE_BYTES=2000000
HTTP_TIMEOUT_SECONDS=15
MAX_REDIRECTS=3
MAX_RETRIES=3
CRAWL_DELAY_SECONDS=0.4
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# ---- Email sending limits ----------------------------------------------------
# Soft ceilings enforced by the scheduler. These are safe defaults for
# development; tune them to stay within provider policies in production.
DAILY_EMAIL_LIMIT=5
MIN_SEND_DELAY_SECONDS=90
MAX_SEND_DELAY_SECONDS=420
ALLOWED_HOURS_START=9
ALLOWED_HOURS_END=19
WORKING_DAYS=1,2,3,4,5

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# ---- Feature flags ----------------------------------------------------------
ALLOW_MOCK_EMAIL_SENDING=true
